<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Checklists YAML en directorio interno -->
    <files-path name="checklists_internal" path="checklists" />

    <!-- Checklists y logs en external files -->
    <external-files-path name="checklists_external" path="checklists" />
    <external-files-path name="logs_external" path="logs" />

    <!-- Cache para archivos temporales al compartir -->
    <cache-path name="cache_share" path="." />

    <!-- Android/media para checklists y logs accesibles al usuario -->
    <external-media-path name="checklists_media" path="checklists" />
    <external-media-path name="logs_media" path="logs" />
</paths>
